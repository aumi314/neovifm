{
  "name": "neovifm-tui",
  "private": true,
  "type": "module",
  "scripts": {
    "build:preview": "bun run scripts/build-preview.ts",
    "dev": "bun run src/index.tsx",
    "test": "bun test ./test/",
    "test:coverage": "bun test ./test/ --coverage --coverage-reporter=text",
    "test:integration": "NEOVIFM_CORE_PROBE=../../src/neovifm-core-probe NEOVIFM_CORE_SESSION=../../src/neovifm-core-session bun test ./integration/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/solid": "0.4.3",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "glob": "11.1.0"
  }
}
