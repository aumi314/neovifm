{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neovifm.dev/protocol/neovifm-core-v3.schema.json",
  "title": "NeoVifm Core Preview Session Protocol v3",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/workspaceSnapshot" },
    { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/preview" },
    { "$ref": "#/$defs/actionTask" },
    { "$ref": "#/$defs/resourceTask" },
    { "$ref": "#/$defs/open" },
    { "$ref": "#/$defs/commandError" },
    { "$ref": "#/$defs/command" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "version", "type", "sequence", "payload"],
      "properties": {
        "protocol": { "const": "neovifm-core" },
        "version": { "const": 3 },
        "type": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "payload": { "type": "object" }
      }
    },
    "hello": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "neovifm-core-v1.schema.json#/$defs/helloPayload" } } }
      ]
    },
    "workspaceSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "workspace-snapshot" },
            "payload": {
              "type": "object",
              "required": ["command_sequence", "trigger", "active_pane", "left", "right"],
              "properties": {
                "command_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "trigger": { "enum": ["initial", "command", "watch", "action", "resource"] },
                "active_pane": { "enum": ["left", "right"] },
                "left": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" },
                "right": { "$ref": "neovifm-core-v1.schema.json#/$defs/paneSnapshot" },
                "left_tabs": { "$ref": "#/$defs/paneTabs" },
                "right_tabs": { "$ref": "#/$defs/paneTabs" }
              }
            }
          }
        }
      ]
    },
    "taskPayload": {
      "type": "object",
      "required": ["task_id", "generation", "pane", "kind", "state", "cwd_bytes_hex", "path_bytes_hex"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "generation": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "pane": { "enum": ["left", "right"] },
        "target_pane": { "enum": ["left", "right"] },
        "kind": { "enum": ["text", "markdown", "pdf", "directory", "archive", "binary", "image", "audio", "video"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os_error": { "type": "integer" }
      }
    },
    "task": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "task" }, "payload": { "$ref": "#/$defs/taskPayload" } } }
      ]
    },
    "preview": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "preview" },
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/taskPayload" },
                {
                  "required": ["truncated"],
                  "properties": {
                    "truncated": { "type": "boolean" },
                    "content": { "type": "string", "maxLength": 65536 }
                  },
                  "$comment": "state must be done, failed, or cancelled; content is required for done"
                }
              ]
            }
          }
        }
      ]
    },
    "actionTaskPayload": {
      "type": "object",
      "required": ["task_id", "command_sequence", "pane", "action", "state", "completed_count", "total_count", "partial"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pane": { "enum": ["left", "right"] },
        "action": { "enum": ["copy", "move", "mkdir", "delete", "rename"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "completed_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "total_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "failed_index": { "type": "integer", "minimum": 0, "maximum": 63 },
        "partial": { "type": "boolean" },
        "retryable": { "type": "boolean" },
        "undo_available": { "type": "boolean" },
        "source_path_bytes_hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$", "maxLength": 32768 },
        "destination_path_bytes_hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$", "maxLength": 32768 },
        "current_path_bytes_hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$", "maxLength": 32768 },
        "bytes_known": { "type": "boolean" },
        "bytes_completed": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "bytes_total": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "started_at_unix_ms": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "finished_at_unix_ms": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os_error": { "type": "integer" }
      }
    },
    "actionTask": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "action-task" }, "payload": { "$ref": "#/$defs/actionTaskPayload" } } }
      ]
    },
    "resourceTaskPayload": {
      "type": "object",
      "required": ["task_id", "command_sequence", "pane", "tab_id", "resource", "state"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 32 },
        "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pane": { "enum": ["left", "right"] },
        "tab_id": { "$ref": "#/$defs/tabId" },
        "resource": { "enum": ["mount-archive", "mount-ssh", "unmount"] },
        "state": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
        "source_path": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "mount_point": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "unmount_path": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os_error": { "type": "integer" }
      }
    },
    "resourceTask": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "resource-task" }, "payload": { "$ref": "#/$defs/resourceTaskPayload" } } }
      ]
    },
    "openPayload": {
      "type": "object",
      "required": ["command_sequence", "intent", "source", "state", "path_bytes_hex", "argv"],
      "properties": {
        "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "intent": { "enum": ["open", "edit", "preview"] },
        "source": { "enum": ["association", "platform"] },
        "state": { "const": "resolved" },
        "path_bytes_hex": { "type": "string", "minLength": 2, "pattern": "^(?:[0-9a-f]{2})+$" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "open": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "open" }, "payload": { "$ref": "#/$defs/openPayload" } } }
      ]
    },
    "commandError": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "command-error" },
            "payload": {
              "type": "object",
              "required": ["command_sequence", "code", "message", "retryable"],
              "properties": {
                "command_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "code": { "type": "string", "minLength": 1, "maxLength": 128 },
                "message": { "type": "string", "maxLength": 16384 },
                "retryable": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "actionTarget": {
      "type": "object",
      "required": ["path_bytes_hex", "device", "inode", "ctime_unix_ns", "kind"],
      "properties": {
        "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "kind": { "enum": ["directory", "file", "symlink", "executable", "fifo", "socket", "char-device", "block-device", "unknown"] }
      }
    },
    "actionTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionTarget" }
    },
    "paneTab": {
      "type": "object",
      "required": ["id", "cwd_display", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/tabId" },
        "cwd_display": { "type": "string", "maxLength": 16384 },
        "active": { "type": "boolean" },
        "resource_kind": { "enum": ["archive", "ssh"] }
      }
    },
    "tabId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "paneTabs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/paneTab" }
    },
    "sourceIdentity": {
      "properties": {
        "pane": { "enum": ["left", "right"] },
        "cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
        "snapshot_revision": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
        "cwd_ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" }
      }
    },
    "commandPayload": {
      "oneOf": [
        { "type": "object", "required": ["action", "pane"], "properties": { "action": { "const": "focus" }, "pane": { "enum": ["left", "right"] } } },
        { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["focus-next", "enter", "parent", "toggle-selection", "refresh"] } } },
        { "type": "object", "required": ["action", "delta"], "properties": { "action": { "const": "move" }, "delta": { "enum": [-1, 1] } } },
        { "type": "object", "required": ["action", "delta"], "properties": { "action": { "const": "sort-cycle" }, "pane": { "enum": ["left", "right"] }, "delta": { "enum": [-1, 1] } } },
        { "type": "object", "required": ["action", "target"], "properties": { "action": { "const": "move-to" }, "target": { "enum": ["first", "last"] } } },
        { "type": "object", "required": ["action", "query", "direction"], "properties": { "action": { "const": "search" }, "query": { "type": "string", "minLength": 1, "maxLength": 255 }, "direction": { "enum": [-1, 1] } } },
        { "type": "object", "required": ["action", "direction"], "properties": { "action": { "const": "search-next" }, "direction": { "enum": [-1, 1] } } },
        { "type": "object", "required": ["action", "pane", "key"], "properties": { "action": { "const": "sort-by" }, "pane": { "enum": ["left", "right"] }, "key": { "enum": ["name", "extension", "size", "ctime", "mtime", "mode", "type", "other"] } } },
        { "type": "object", "required": ["action", "pane", "index", "toggle"], "properties": { "action": { "const": "select-entry" }, "pane": { "enum": ["left", "right"] }, "index": { "type": "integer", "minimum": 0, "maximum": 4095 }, "toggle": { "type": "boolean" } } },
        { "type": "object", "required": ["action", "pane"], "properties": { "action": { "const": "new-tab" }, "pane": { "enum": ["left", "right"] } } },
        { "type": "object", "required": ["action", "pane", "tab_id"], "properties": { "action": { "enum": ["activate-tab", "close-tab"] }, "pane": { "enum": ["left", "right"] }, "tab_id": { "$ref": "#/$defs/tabId" } } },
        { "type": "object", "required": ["action", "delta"], "properties": { "action": { "const": "tab-cycle" }, "delta": { "type": "integer", "minimum": -999, "maximum": 999, "not": { "const": 0 } } } },
        { "type": "object", "required": ["action"], "properties": { "action": { "const": "undo" } } },
        { "type": "object", "required": ["action", "task_id"], "properties": { "action": { "enum": ["cancel-action", "retry-action"] }, "task_id": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" } } },
        { "type": "object", "required": ["action", "task_id"], "properties": { "action": { "const": "cancel-resource" }, "task_id": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" } } },
        { "type": "object", "required": ["action", "pane", "remote"], "properties": { "action": { "const": "mount-ssh" }, "pane": { "enum": ["left", "right"] }, "remote": { "type": "string", "minLength": 1, "maxLength": 16384 } } },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "target_pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "path_bytes_hex", "device", "inode", "ctime_unix_ns"],
              "properties": {
                "action": { "const": "preview" },
                "target_pane": { "enum": ["left", "right"] },
                "path_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
                "device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "intent", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "path_bytes_hex", "device", "inode", "ctime_unix_ns"],
              "properties": {
                "action": { "const": "open" },
                "intent": { "const": "open" },
                "path_bytes_hex": { "type": "string", "minLength": 2, "pattern": "^(?:[0-9a-f]{2})+$" },
                "device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "association_argv": {
                  "type": "array",
                  "maxItems": 31,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "destination_cwd_bytes_hex", "destination_snapshot_revision", "destination_cwd_device", "destination_cwd_inode", "destination_cwd_ctime_unix_ns", "targets"],
              "properties": {
                "action": { "enum": ["copy", "move-files"] },
                "destination_cwd_bytes_hex": { "$ref": "neovifm-core-v0.schema.json#/$defs/hexBytes" },
                "destination_snapshot_revision": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_device": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_inode": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "destination_cwd_ctime_unix_ns": { "$ref": "neovifm-core-v0.schema.json#/$defs/unsignedDecimalString" },
                "targets": { "$ref": "#/$defs/actionTargets" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "targets"],
              "properties": { "action": { "const": "delete" }, "targets": { "$ref": "#/$defs/actionTargets" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "name"],
              "properties": { "action": { "const": "mkdir" }, "name": { "type": "string", "minLength": 1, "maxLength": 255 } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sourceIdentity" },
            {
              "type": "object",
              "required": ["action", "pane", "cwd_bytes_hex", "snapshot_revision", "cwd_device", "cwd_inode", "cwd_ctime_unix_ns", "targets", "name"],
              "properties": {
                "action": { "const": "rename" },
                "targets": { "$ref": "#/$defs/actionTargets", "minItems": 1, "maxItems": 1 },
                "name": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            }
          ]
        }
      ]
    },
    "command": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/commandPayload" } } }
      ]
    }
  }
}
