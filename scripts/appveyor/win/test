#!/bin/bash
set -e

# copy regex library dll where tests binaries lie
mkdir -p tests/bin
cp src/mingw-libgnurx-2.5.1/*.dll tests/bin

test_args=(
    'TESTS_CFLAGS=-I ../src/PDCurses-3.8/ -I ../src/mingw-libgnurx-2.5.1'
    'TESTS_LDFLAGS=-L ../src/PDCurses-3.8/wincon -L ../src/mingw-libgnurx-2.5.1'
)

# build tests in parallel
make -C tests/ -j3 build "${test_args[@]}"

# Run the existing suites sequentially for serial output.  The NeoVifm focused
# fixtures use separate processes on Windows so asynchronous helpers and
# environment changes cannot leak into later fixtures.
make -C tests/ check-excluding-neovifm-snapshot "${test_args[@]}"
focused_status=0
for source in tests/neovifm_snapshot/*.c; do
    fixture="$(basename "$source" .c)"
    case "$fixture" in
        suite) continue ;;
    esac
    make -C tests/ TEST_RUN_FLAGS=-v "neovifm_snapshot.$fixture" "${test_args[@]}" || focused_status=1
done
exit "$focused_status"
